# Copie para .env e preencha. O .env NÃO vai para o git (está no .gitignore).
# Em CI, use os secrets do repositório em vez de um arquivo.

ODOO_URL=https://SEU-HOST-ODOO
ODOO_DB=SEU_BANCO
ODOO_LOGIN=usuario.integracao
ODOO_PASSWORD=

# Recomendado: usar um usuário de integração só-leitura, não a conta de uma pessoa.
# O que o script vê depende das permissões desse usuário (há regras por empresa
# no MMP), então os números podem mudar conforme o login usado.
